{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygui.local/contracts/scanner-result.schema.json",
  "title": "MyGUI ScannerResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "scanner", "status", "verdict", "scope", "startedAt", "durationMs", "findings", "grayBoundaries", "coverage", "errors", "diagnostics", "summary"],
  "properties": {
    "contractVersion": {"const": 2},
    "scanner": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "status": {"enum": ["completed", "partial", "failed"]},
    "verdict": {"enum": ["clean", "violation", "gray_boundary", "unknown"]},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace", "include", "exclude", "changedFiles"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "include": {"$ref": "#/$defs/strings"},
        "exclude": {"$ref": "#/$defs/strings"},
        "changedFiles": {"$ref": "#/$defs/strings"}
      }
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "number", "minimum": 0},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "grayBoundaries": {"type": "array", "items": {"$ref": "#/$defs/grayBoundary"}},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["filesVisited", "filesSkipped", "limitations"],
      "properties": {
        "filesVisited": {"$ref": "#/$defs/workspaceRelativePaths"},
        "filesSkipped": {"type": "array", "items": {"$ref": "#/$defs/skippedFile"}},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["findings", "grayBoundaries", "errors", "bySeverity"],
      "properties": {
        "findings": {"type": "integer", "minimum": 0},
        "grayBoundaries": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "bySeverity": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "info": {"type": "integer", "minimum": 0}, "low": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0}, "high": {"type": "integer", "minimum": 0},
            "critical": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "workspaceRelativePath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:[\\\\/])(?!\\.\\.(?:[\\\\/]|$)).+"
    },
    "workspaceRelativePaths": {
      "type": "array", "items": {"$ref": "#/$defs/workspaceRelativePath"}, "uniqueItems": true
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["file"],
      "properties": {"file": {"$ref": "#/$defs/workspaceRelativePath"}, "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 1}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scannerId", "ruleId", "severity", "confidence", "file", "title", "evidence", "reason", "suggestedAction", "tags", "fingerprint"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "scannerId": {"type": "string", "minLength": 1},
        "ruleId": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "file": {"$ref": "#/$defs/workspaceRelativePath"},
        "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 1},
        "title": {"type": "string"}, "evidence": {"type": "string"}, "reason": {"type": "string"},
        "suggestedAction": {"type": "string"}, "tags": {"$ref": "#/$defs/strings"}, "fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "grayBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scannerId", "category", "confidence", "file", "evidence", "whyNotViolation", "evolutionCandidate", "fingerprint"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "scannerId": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "file": {"$ref": "#/$defs/workspaceRelativePath"}, "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 1},
        "evidence": {"type": "string"}, "whyNotViolation": {"type": "string"},
        "evolutionCandidate": {"type": "string"}, "fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "skippedFile": {
      "type": "object", "additionalProperties": false, "required": ["file", "reason"],
      "properties": {"file": {"$ref": "#/$defs/workspaceRelativePath"}, "reason": {"type": "string", "minLength": 1}}
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "recoverable"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "recoverable": {"type": "boolean"}, "file": {"$ref": "#/$defs/workspaceRelativePath"}}
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["level", "message"],
      "properties": {"level": {"enum": ["info", "warning", "error"]}, "message": {"type": "string", "minLength": 1}, "file": {"$ref": "#/$defs/workspaceRelativePath"}}
    }
  }
}
