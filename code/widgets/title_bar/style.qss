QFrame#title_bar
{
    background-color: {{COLOR_COMMAND_BACKGROUND}};
    min-height: 120px;
    max-height: 120px;
    border: 0px;
}

QFrame#selector_menu_bar,
QFrame#menu_bar
{
    background-color: {{COLOR_COMMAND_BACKGROUND}};
    min-height: {{SIZE_COMMAND_ROW}}px;
    max-height: {{SIZE_COMMAND_ROW}}px;
    border: 0px;
}

QFrame#command_separator
{
    background-color: #94a3b8;
    min-width: 1px;
    max-width: 1px;
    min-height: 28px;
    max-height: 28px;
    border: 0px;
    margin: 0px;
}

QPushButton#change_button
{
    min-width: 36px;
    max-width: 36px;
    min-height: 44px;
    max-height: 44px;
    background-color: transparent;
    border: 2px solid transparent;
    icon-size: 24px;
}

QPushButton#change_button:hover,
QPushButton#change_button:focus
{
    background-color: #1f2937;
    border-color: {{COLOR_FOCUS}};
}

QPushButton#change_button:checked
{
    background-color: {{COLOR_SURFACE}};
}

QPushButton#select_menu_button,
QPushButton#menu_button
{
    min-height: 44px;
    max-height: 44px;
    min-width: 72px;
    padding: 0px {{SPACE_SM}}px;
    background-color: transparent;
    border: 2px solid transparent;
    color: {{COLOR_TEXT_ON_DARK}};
    font-weight: 600;
    icon-size: 22px;
}

QPushButton#select_menu_button:hover,
QPushButton#menu_button:hover
{
    background-color: #1f2937;
}

QPushButton#select_menu_button:focus,
QPushButton#menu_button:focus
{
    border-color: {{COLOR_FOCUS}};
}

QPushButton#select_menu_button:checked
{
    background-color: {{COLOR_SURFACE}};
    border-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
}

QPushButton#select_menu_button:checked:focus
{
    border-color: {{COLOR_FOCUS}};
}

QFrame#selector_menu
{
    background-color: {{COLOR_SURFACE}};
    min-height: {{SIZE_TOOL_GALLERY}}px;
    max-height: {{SIZE_TOOL_GALLERY}}px;
    border: 0px;
}

QToolBar#selector_toolbar
{
    background-color: {{COLOR_SURFACE}};
    border: 0px;
    border-bottom: 1px solid #d1d5db;
    spacing: {{SPACE_XS}}px;
    padding: 2px {{SPACE_XS}}px;
}

QToolBar#selector_toolbar QToolButton,
QToolButton#select_button
{
    min-width: 64px;
    max-width: 100px;
    min-height: 60px;
    max-height: 60px;
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: {{RADIUS_MD}}px;
    color: {{COLOR_TEXT_PRIMARY}};
    padding: 1px {{SPACE_XS}}px;
}

QToolBar#selector_toolbar QToolButton:hover,
QToolButton#select_button:hover
{
    background-color: #e5e7eb;
    border-color: #9ca3af;
}

QToolBar#selector_toolbar QToolButton:pressed,
QToolBar#selector_toolbar QToolButton:checked
{
    background-color: #dbeafe;
    border-color: {{COLOR_ACCENT}};
}

QToolBar#selector_toolbar QToolButton:focus,
QToolButton#select_button:focus
{
    border-color: {{COLOR_FOCUS}};
}

QToolBar#selector_toolbar QToolButton:disabled
{
    color: #9ca3af;
}

QToolBar#selector_toolbar QToolButton#qt_toolbar_ext_button
{
    min-width: 28px;
    max-width: 28px;
    min-height: 60px;
    max-height: 60px;
    padding: 0px;
    border: 2px solid transparent;
    icon-size: 18px;
}

QToolBar#selector_toolbar QToolButton#qt_toolbar_ext_button:hover
{
    background-color: #e5e7eb;
    border-color: #9ca3af;
}

QToolBar#selector_toolbar QToolButton#qt_toolbar_ext_button:focus
{
    border-color: {{COLOR_FOCUS}};
}

QPushButton#pull_down_button
{
    min-width: 32px;
    min-height: 48px;
    background-color: transparent;
    border: 2px solid transparent;
    icon-size: 18px;
}

QPushButton#pull_down_button:hover,
QPushButton#pull_down_button:focus
{
    background-color: #e5e7eb;
    border-color: {{COLOR_FOCUS}};
}
