QFrame
{
    background-color:#EBECF0;
    border-radius: 5px;
}

QPlainTextEdit
{
    background-color:#ffffff;
    border-radius: 5px;
}

QToolBox::tab {
    background: #EBECF0;
    border-radius: 5px;
    font-size: 16px;
    color: #6d6868;
}

QToolBox::tab:selected {
    background: #0281ff;
    font: bold;
    color: white;
}

QDoubleSpinBox {
    border : 1px solid #000000;
    border-radius: 5px;
    width: 30px;
}
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-width: 1px;
}
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-width: 1px;
    border-top-width: 0;
}