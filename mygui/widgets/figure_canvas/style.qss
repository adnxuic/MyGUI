QFrame#figure_window
{
    background-color: {{COLOR_CONTENT_BACKGROUND}};
    color: {{COLOR_TEXT_PRIMARY}};
    border: 1px solid {{COLOR_BORDER}};
}

QScrollArea,
QStackedWidget#figure_canvas_content_stack,
QStackedWidget#figure_canvas_content_stack > QWidget
{
    background-color: {{COLOR_CONTENT_BACKGROUND}};
    color: {{COLOR_TEXT_PRIMARY}};
    border: 0px;
}

QFrame#figure_empty_state
{
    background-color: {{COLOR_SURFACE}};
}

QLabel#figure_popout_placeholder
{
    background-color: {{COLOR_CONTENT_BACKGROUND}};
    color: {{COLOR_TEXT_MUTED}};
    padding: {{SPACE_LG}}px;
}

QToolBar#figure_toolbar
{
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
    border: 0px;
    border-bottom: 1px solid {{COLOR_BORDER}};
    spacing: {{SPACE_XS}}px;
    padding: 2px {{SPACE_XS}}px;
}
