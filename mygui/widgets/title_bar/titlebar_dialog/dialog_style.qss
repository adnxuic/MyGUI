QDialog
{
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
    border: 1px solid {{COLOR_BORDER}};
    border-radius: {{RADIUS_MD}}px;
    min-width: 280px;
}

QDialog#layout_dialog
{
    min-width: 560px;
}

QLabel#export_error_label,
QLabel#chrome_error_label,
QLabel#layout_validation_message,
QLabel#xrd_refinement_validation
{
    color: {{COLOR_TEXT_DANGER}};
}

QLabel#export_hint_label
{
    color: {{COLOR_TEXT_MUTED}};
}

QLabel#axis_tick_index_hint
{
    color: {{COLOR_TEXT_MUTED}};
    font-style: italic;
}

QLabel#axis_tick_preview_status
{
    color: {{COLOR_TEXT_DANGER}};
}

QLabel#import_summary_label[level="error"]
{
    color: {{COLOR_TEXT_DANGER}};
}

QLabel#import_summary_label[level="success"]
{
    color: {{COLOR_TEXT_SUCCESS}};
}

QLabel#import_summary_label[level="info"]
{
    color: {{COLOR_TEXT_INFO}};
}
