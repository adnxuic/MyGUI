/*
 * Process-global stylesheet for combo popups, spin arrows, and QMessageBox.
 * Colors come from QPalette so Light/Dark does not call QApplication.setStyleSheet
 * on the whole workbench. Shared control chrome lives on regional bind_qss sheets.
 */

QComboBox QAbstractItemView
{
    border: 1px solid;
    border-radius: {{RADIUS_SM}}px;
    padding: 2px;
    outline: 0px;
}

QMessageBox QPushButton
{
    min-width: 72px;
}

QComboBox::drop-down
{
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: {{SIZE_INDICATOR}}px;
    border: 0px;
    background-color: transparent;
}

QComboBox::drop-down:hover
{
    border-top-right-radius: {{RADIUS_SM}}px;
    border-bottom-right-radius: {{RADIUS_SM}}px;
}

QComboBox::down-arrow
{
    image: url({{ICON_ARROW_DOWN}});
    width: {{SIZE_SCROLLBAR}}px;
    height: {{SIZE_SCROLLBAR}}px;
}

QAbstractSpinBox[uiRole="number"]::up-button
{
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: {{SIZE_INDICATOR}}px;
    border: 0px;
    border-left: 1px solid;
    background-color: transparent;
}

QAbstractSpinBox[uiRole="number"]::up-arrow
{
    image: url({{ICON_ARROW_UP}});
    width: {{SIZE_SCROLLBAR}}px;
    height: {{SIZE_SCROLLBAR}}px;
}

QAbstractSpinBox[uiRole="number"]::down-button
{
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: {{SIZE_INDICATOR}}px;
    border: 0px;
    border-left: 1px solid;
    background-color: transparent;
}

QAbstractSpinBox[uiRole="number"]::down-arrow
{
    image: url({{ICON_ARROW_DOWN}});
    width: {{SIZE_SCROLLBAR}}px;
    height: {{SIZE_SCROLLBAR}}px;
}
