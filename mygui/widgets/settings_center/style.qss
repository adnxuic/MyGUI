QDialog#setting_dialog
{
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
    border: 1px solid {{COLOR_BORDER}};
}

QFrame#settings_nav_pane
{
    background-color: {{COLOR_SURFACE_ALT}};
    border-right: 1px solid {{COLOR_BORDER}};
}

QListWidget#settings_nav
{
    background-color: transparent;
    border: 0px;
    color: {{COLOR_TEXT_PRIMARY}};
    outline: none;
}

QListWidget#settings_nav::item
{
    min-height: 28px;
    padding: {{SPACE_SM}}px {{SPACE_MD}}px;
    border-radius: {{RADIUS_SM}}px;
}

QListWidget#settings_nav::item:selected
{
    background-color: {{COLOR_ACCENT}};
    color: {{COLOR_TEXT_ON_DARK}};
}

QListWidget#settings_nav::item:selected:focus
{
    border: 2px solid {{COLOR_FOCUS}};
}

QListWidget#settings_nav::item:hover:!selected
{
    background-color: {{COLOR_HOVER_LIGHT}};
}

QLabel#settings_page_title
{
    font-weight: 600;
    color: {{COLOR_TEXT_PRIMARY}};
}

QLabel#settings_page_description,
QLabel#settings_status,
QLabel#export_settings_dpi_hint,
QLabel#integrations_intro
{
    color: {{COLOR_TEXT_MUTED}};
}

QScrollArea#settings_page_scroll
{
    background-color: {{COLOR_SURFACE}};
    border: 0px;
}

QFrame#settings_footer
{
    background-color: {{COLOR_SURFACE}};
    border-top: 1px solid {{COLOR_BORDER}};
}

QListWidget#settings_template_list
{
    background-color: {{COLOR_SURFACE}};
    border: 1px solid {{COLOR_BORDER}};
    border-radius: {{RADIUS_SM}}px;
    color: {{COLOR_TEXT_PRIMARY}};
    outline: none;
}

QListWidget#settings_template_list::item
{
    min-height: 28px;
    padding: {{SPACE_SM}}px {{SPACE_MD}}px;
}

QListWidget#settings_template_list::item:selected
{
    background-color: {{COLOR_ACCENT}};
    color: {{COLOR_TEXT_ON_DARK}};
}

QListWidget#settings_template_list::item:selected:focus
{
    border: 2px solid {{COLOR_FOCUS}};
}

QListWidget#settings_template_list::item:hover:!selected
{
    background-color: {{COLOR_HOVER_LIGHT}};
}

QFrame#template_header_card
{
    background-color: transparent;
    border: none;
}

QLabel#template_detail_title
{
    font-size: 16px;
    font-weight: 600;
    color: {{COLOR_TEXT_PRIMARY}};
}

QLabel#template_detail_timestamps
{
    color: {{COLOR_TEXT_MUTED}};
    font-size: 11px;
}

QLabel#template_section_header
{
    font-weight: 600;
    color: {{COLOR_TEXT_PRIMARY}};
    font-size: 12px;
}

QLabel#template_spec_subtitle
{
    font-weight: 600;
    color: {{COLOR_TEXT_MUTED}};
    font-size: 11px;
}

QLabel#template_empty_title,
QLabel#template_miss_title
{
    font-weight: 600;
    font-size: 14px;
    color: {{COLOR_TEXT_PRIMARY}};
}

QLabel#template_empty_description,
QLabel#template_miss_description,
QLabel#template_error_detail
{
    color: {{COLOR_TEXT_MUTED}};
}

QLabel#template_error_title
{
    font-weight: 600;
    color: {{COLOR_TEXT_PRIMARY}};
}

QFrame#template_spec_card
{
    background-color: {{COLOR_SURFACE_ALT}};
    border: 1px solid {{COLOR_BORDER}};
    border-radius: {{RADIUS_SM}}px;
}

QPlainTextEdit#template_contract_label
{
    border: 1px solid {{COLOR_BORDER}};
    border-radius: {{RADIUS_SM}}px;
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
    padding: {{SPACE_XS}}px {{SPACE_SM}}px;
}

QPlainTextEdit#template_notes_edit
{
    border: 1px solid {{COLOR_BORDER}};
    border-radius: {{RADIUS_SM}}px;
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
    padding: {{SPACE_XS}}px {{SPACE_SM}}px;
}

QFrame#template_error_box
{
    background-color: {{COLOR_ERROR_SOFT}};
    border: 1px solid {{COLOR_ERROR}};
    border-radius: {{RADIUS_SM}}px;
}

QFrame#template_empty_box,
QFrame#template_miss_box
{
    background-color: {{COLOR_SURFACE_ALT}};
    border: 1px dashed {{COLOR_BORDER}};
    border-radius: {{RADIUS_MD}}px;
}


