QFrame#left_column
{
    background-color: #f8fafc;
    min-width: {{SIZE_ACTIVITY_RAIL}}px;
    max-width: {{SIZE_ACTIVITY_RAIL}}px;
    border: 0px;
    padding: 0px;
    margin: 0px;
}

QPushButton#table_button,
QPushButton#components_button,
QPushButton#setting_button
{
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    icon-size: 24px;
}

QPushButton#table_button:hover,
QPushButton#components_button:hover,
QPushButton#setting_button:hover
{
    background-color: #e5e7eb;
}

QPushButton#table_button:focus,
QPushButton#components_button:focus,
QPushButton#setting_button:focus
{
    border-color: {{COLOR_FOCUS}};
}

QPushButton#table_button:checked,
QPushButton#components_button:checked
{
    background-color: {{COLOR_ACCENT}};
    border-color: {{COLOR_ACCENT}};
}

QPushButton#table_button:checked:focus,
QPushButton#components_button:checked:focus
{
    border-color: {{COLOR_FOCUS}};
}
