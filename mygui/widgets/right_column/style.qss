QFrame#right_column
{
    background-color: {{COLOR_COMMAND_BACKGROUND}};
    min-width: {{SIZE_ACTIVITY_RAIL}}px;
    max-width: {{SIZE_ACTIVITY_RAIL}}px;
    border: 0px;
    padding: 0px;
    margin: 0px;
}

QPushButton#tex_button,
QPushButton#matlab_button
{
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 0px;
    padding: 0px;
    icon-size: 22px;
}

QPushButton#tex_button:hover,
QPushButton#matlab_button:hover
{
    background-color: #1f2937;
}

QPushButton#tex_button:focus,
QPushButton#matlab_button:focus
{
    border-color: {{COLOR_FOCUS}};
}

QPushButton#tex_button:checked,
QPushButton#matlab_button:checked
{
    background-color: {{COLOR_SURFACE}};
    border-color: {{COLOR_SURFACE}};
}

QPushButton#tex_button:checked:focus,
QPushButton#matlab_button:checked:focus
{
    border-color: {{COLOR_FOCUS}};
}
