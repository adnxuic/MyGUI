QFrame#common_mod_widget,
QFrame#bottom_spine_mod_widget,
QFrame#top_spine_mod_widget,
QFrame#left_spine_mod_widget,
QFrame#right_spine_mod_widget,
QFrame#axe_legend_mod_widget
{
    background-color: {{COLOR_SURFACE_ALT}};
    color: {{COLOR_TEXT_PRIMARY}};
    border-radius: {{RADIUS_MD}}px;
}

QLabel, QCheckBox, QRadioButton, QGroupBox
{
    color: {{COLOR_TEXT_PRIMARY}};
}
