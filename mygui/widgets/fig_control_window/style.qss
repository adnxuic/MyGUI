QFrame#fig_control_window,
QFrame#figure_inspector_host,
QFrame#tex_window,
QFrame#matlab_window
{
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
    border: 0px;
    padding: 0px;
    margin: 0px;
}

QScrollArea#inspector_scroll_area
{
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
    border: 0px;
}

QScrollArea#inspector_scroll_area > QWidget,
QScrollArea#inspector_scroll_area > QWidget > QWidget
{
    background-color: {{COLOR_SURFACE}};
    color: {{COLOR_TEXT_PRIMARY}};
}

QFrame#fig_control_window QLabel,
QFrame#fig_control_window QCheckBox,
QFrame#fig_control_window QRadioButton,
QFrame#fig_control_window QGroupBox
{
    color: {{COLOR_TEXT_PRIMARY}};
}

QLabel#axes_twin_hint
{
    color: {{COLOR_TEXT_MUTED}};
    font-style: italic;
}

QLabel#errorbar_data_hint
{
    color: {{COLOR_TEXT_DANGER}};
}
